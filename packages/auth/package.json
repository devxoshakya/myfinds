{
  "name": "@myfinds/auth",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.js"
    },
    "./*": {
      "bun": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./src/*.js"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@myfinds/db": "workspace:*",
    "better-auth": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@myfinds/config": "workspace:*",
    "typescript": "catalog:"
  }
}
