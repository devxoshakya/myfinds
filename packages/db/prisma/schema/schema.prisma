// Generator + datasource only. Domain models are split per concept:
//   auth.prisma        Better Auth tables (user, session, account, verification)
//   enums.prisma       All shared enums
//   places.prisma      State, City, Station
//   staff.prisma       StationStaff
//   report.prisma      Report (central entity)
//   photo.prisma       Photo (private R2 objects)
//   question.prisma    VerificationQuestion (owner hidden detail)
//   match.prisma       Match (rule-based pairing)
//   claim.prisma       Claim + handover code metadata
//   history.prisma     StatusHistory (append-only)
//   notification.prisma Notification delivery log
// All model docs live in docs/model.md; see also prisma/sql/extensions.sql
// for the raw SQL pieces (pg_trgm, searchVector, append-only trigger).

generator client {
  provider = "prisma-client"
  output = "../generated"
  moduleFormat = "esm"
  // "node" so the generated client also runs on Vercel's Node serverless
  // runtime; Bun runs Node-style output fine, so local dev is unaffected.
  runtime = "nodejs"
}

datasource db {
  provider = "postgresql"
}
