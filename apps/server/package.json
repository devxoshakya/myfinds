{
  "name": "server",
  "main": "src/index.ts",
  "scripts": {
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "db:generate": "cd ../../packages/db && bun run db:generate",
    "start": "bun run src/index.ts",
    "auth:generate": "bun x auth@latest generate --config src/services.ts --output ../../packages/db/prisma/schema/auth.prisma --yes",
    "staff:create": "bun run scripts/create-staff.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@myfinds/auth": "workspace:*",
    "@myfinds/db": "workspace:*",
    "@myfinds/shared": "workspace:*",
    "better-auth": "catalog:",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@myfinds/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "typescript": "catalog:"
  }
}
