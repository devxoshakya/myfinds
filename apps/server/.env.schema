# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @type=string(minLength=1)
DIRECT_URL=

# S3-compatible object storage (Supabase Storage S3 protocol or Cloudflare R2).
# Endpoint, region, bucket and access key id all appear inside presigned URLs
# sent to the browser (that is how S3 presigning works), so varlock's leak
# detector must not treat them as secrets. Only the secret access key below
# is sensitive — it never leaves the server.

# @optional @public @type=url
S3_ENDPOINT=

# @optional @public
S3_REGION=

# @optional @public
S3_ACCESS_KEY_ID=

# @optional @sensitive
S3_SECRET_ACCESS_KEY=

# @optional @public
S3_BUCKET_NAME=
