# Copy to apps/server/.env and fill in. Never commit the real file.

# Database (Supabase pooler for runtime, direct for migrations)
DATABASE_URL=postgres://user:password@host:6543/postgres
DIRECT_URL=postgres://user:password@host:5432/postgres?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Web app origin (also used for CORS and as the email-link fallback)
CORS_ORIGIN=http://localhost:3001

# Private photo storage (Supabase Storage S3 protocol or any S3-compatible)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Transactional email (Resend). Create the key at https://resend.com/api-keys
RESEND_API_KEY=
# Use a verified domain in production; onboarding@resend.dev only delivers to
# the Resend account owner's own email.
EMAIL_FROM="MyFinds <onboarding@resend.dev>"
# Public web app URL used for links inside emails
APP_URL=http://localhost:3001
